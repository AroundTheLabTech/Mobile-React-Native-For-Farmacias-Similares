# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

# Arquitectura clásica, igual que Android (newArchEnabled=false en android/gradle.properties). Con la
# nueva, la app compila pero truena al abrir (RCTEventEmitter … not registered as callable).
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SimiJuegos' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'SimiJuegosTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_VERSION'] = '5.0'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        
        # ⭐ SOLUCIÓN PARA EL ERROR swiftCompatibility56 ⭐
        # Forzar el linker a incluir la biblioteca de compatibilidad
        config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
        config.build_settings['OTHER_LDFLAGS'] << '-lswiftCompatibility56'
        
        # Alternativa: si lo anterior no funciona, descomenta esta línea
        # config.build_settings['OTHER_LDFLAGS'] << '-lswiftCompatibilityDynamicLookup'

        # fmt 11.0.2 (React Native 0.77) no compila con el clang de Xcode 26 en C++20
        # ("call to consteval function ... is not a constant expression"): se compila en C++17.
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end